<Project>
  <PropertyGroup>
    <LowerFramework>$(TargetFramework.ToLower())</LowerFramework>
    <LowerFrameworks>$(TargetFrameworks.ToLower())</LowerFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="$(AllowUnsafeBlocks) == 'true' ">
    <DefineConstants>$(DefineConstants);AllowUnsafeBlocks</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(PolyPublic) == 'true' ">
    <DefineConstants>$(DefineConstants);PolyPublic</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(PolyUseEmbeddedAttribute) == 'true' ">
    <DefineConstants>$(DefineConstants);PolyUseEmbeddedAttribute</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(LowerFramework.StartsWith('netcoreapp2'))">
    <DefineConstants>$(DefineConstants);NETCOREAPP2X</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(LowerFramework.StartsWith('netcoreapp3'))">
    <DefineConstants>$(DefineConstants);NETCOREAPP3X</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(LowerFramework.StartsWith('net46'))">
    <DefineConstants>$(DefineConstants);NET46X</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(LowerFramework.StartsWith('net47'))">
    <DefineConstants>$(DefineConstants);NET47X</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(LowerFramework.StartsWith('net48'))">
    <DefineConstants>$(DefineConstants);NET48X</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(LowerFramework.StartsWith('netcoreapp2')) or
                            $(LowerFramework.StartsWith('netcoreapp3'))">
    <DefineConstants>$(DefineConstants);NETCOREAPPX</DefineConstants>
  </PropertyGroup>
  <!-- begin-snippet: MaxNetRequired -->
  <PropertyGroup>
    <MaxNetRequired>false</MaxNetRequired>
    <MaxNetRequired
      Condition="($(LowerFrameworks.Contains('net5')) OR
                 $(LowerFrameworks.Contains('net6')) OR
                 $(LowerFrameworks.Contains('net7')) OR
                 $(LowerFrameworks.Contains('net8')) OR
                 $(LowerFrameworks.Contains('netstandard')) OR
                 $(LowerFrameworks.Contains('netcore')))
                 AND
                 !$(LowerFrameworks.Contains('net9'))
                 AND
                 !$(LowerFramework.Contains('net9'))"
      >true</MaxNetRequired>
    <MaxNetClassicRequired>false</MaxNetClassicRequired>
    <MaxNetClassicRequired
      Condition="(
                   $(LowerFrameworks.Contains('net4')) OR
                   $(LowerFrameworks.Contains('netstandard'))
                 )
                 AND
                 !$(LowerFramework.Contains('net48'))
                 AND
                 !$(LowerFrameworks.Contains('net48'))"
      >true</MaxNetClassicRequired>
  </PropertyGroup>
  <!-- end-snippet -->
  <!-- begin-snippet: PolyfillValidateNugetTargets -->
  <Target
      Name="PolyfillValidateNugetTargets"
      AfterTargets="AfterBuild"
      Condition="$(NoWarn.Contains('PolyfillTargetsForNuget')) != true And '$(GeneratePackageOnBuild)' == 'true'">
    <Warning
        Code="PolyfillTargetsForNuget"
        Text="Projects that produce a nuget and consume Polyfill:
For best performance all frameworks from the lowest TargetFramework up to and including net48 should be targeted.
For example:
 * If a nuget's minimum target is net47, then the resulting TargetFrameworks should include net471, net472, and net48.
 * If a nuget's minimum target net6, then the resulting TargetFrameworks should include net7.0 and net8.0."
        HelpLink="https://github.com/SimonCropp/Polyfill#targetframeworks"
        Condition="$(MaxNetRequired)" />
  </Target>
  <!-- end-snippet -->

  <ItemGroup>
    <ResolveFeature Include="FeatureValueTuple" NuGetPackageId="System.ValueTuple" />
    <ResolveFeature Include="RefsBclMemory" NuGetPackageId="Microsoft.Bcl.Memory" />
    <ResolveFeature Include="FeatureMemory" NuGetPackageId="System.Memory" NuGetPackageVersion="4.5.5" />
    <ResolveFeature Include="FeatureRuntimeInformation" NuGetPackageId="System.Runtime.InteropServices.RuntimeInformation" />
    <ResolveFeature Include="FeatureValueTask" NuGetPackageId="System.Threading.Tasks.Extensions" />
    <ResolveFeature Include="FeatureHttp" NuGetPackageId="System.Net.Http" ReferenceFilename="System.Net.Http" />
    <ResolveFeature Include="FeatureCompression" NuGetPackageId="System.IO.Compression" ReferenceFilename="System.IO.Compression" />
    <ResolveFeature Include="FeatureNumerics" ReferenceFilename="System.Numerics" />
    <ResolveFeature Include="FeatureNumerics" ReferenceFilename="System.Runtime.Numerics" />
    <ResolveFeature Include="FeatureAsyncInterfaces" NuGetPackageId="Microsoft.Bcl.AsyncInterfaces" />
    <ResolveFeature Include="FeatureUnsafe" NuGetPackageId="System.Runtime.CompilerServices.Unsafe" />
  </ItemGroup>

  <!-- ReferencePath carries NuGet metadata in normal old-style projects;
       ResolvedCompileFileDefinitions retains it in SDK WPF temporary projects.

       Legacy WPF temporary projects lose package metadata on their copied
       ReferencePath and skip NuGet contentFiles compilation. Falling back to
       PackageReference or PackageVersion would enable features without the
       corresponding Polyfill source files, so they are not supported. -->
  <Target Name="_PolyfillCollectPackageAssets">
    <ItemGroup>
      <_PolyfillPackageAssets Include="@(ReferencePath);@(ResolvedCompileFileDefinitions)" />
    </ItemGroup>
  </Target>

  <Target Name="_PolyfillResolveFeature"
          DependsOnTargets="_PolyfillCollectPackageAssets"
          Inputs="@(ResolveFeature)"
          Outputs="%(ResolveFeature.Identity).%(ResolveFeature.ReferenceFilename).polyfill-feature">
    <PropertyGroup>
      <_PolyfillPackageId>%(ResolveFeature.NuGetPackageId)</_PolyfillPackageId>
      <_PolyfillMinimumVersion>%(ResolveFeature.NuGetPackageVersion)</_PolyfillMinimumVersion>
      <_PolyfillReferenceFilename>%(ResolveFeature.ReferenceFilename)</_PolyfillReferenceFilename>
      <_PolyfillResolvedVersion Condition="'$(_PolyfillMinimumVersion)' != ''">@(_PolyfillPackageAssets->WithMetadataValue('NuGetPackageId', '$(_PolyfillPackageId)')->Metadata('NuGetPackageVersion')->Distinct())</_PolyfillResolvedVersion>
    </PropertyGroup>
    <ItemGroup>
      <_PolyfillResolvedFeature Include="%(ResolveFeature.Identity)" Condition="'$(_PolyfillReferenceFilename)' != '' AND @(ReferencePath->AnyHaveMetadataValue('Filename', '$(_PolyfillReferenceFilename)'))" />
      <_PolyfillResolvedFeature Include="%(ResolveFeature.Identity)" Condition="'$(_PolyfillPackageId)' != '' AND '$(_PolyfillMinimumVersion)' == '' AND @(_PolyfillPackageAssets->AnyHaveMetadataValue('NuGetPackageId', '$(_PolyfillPackageId)'))" />
      <_PolyfillResolvedFeature Include="%(ResolveFeature.Identity)" Condition="'$(_PolyfillResolvedVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals($(_PolyfillResolvedVersion), $(_PolyfillMinimumVersion)))" />
      <_PolyfillResolvedFeatureVersion Include="%(ResolveFeature.Identity)" Version="$(_PolyfillResolvedVersion)"
                                       Condition="'$(_PolyfillMinimumVersion)' != '' AND '$(_PolyfillResolvedVersion)' != ''" />
    </ItemGroup>
  </Target>

  <Target Name="PolyfillResolveFeatures"
          DependsOnTargets="_PolyfillResolveFeature"
          AfterTargets="ResolveAssemblyReferences"
          BeforeTargets="CoreCompile">
    <PropertyGroup>
      <DefineConstants Condition="'@(_PolyfillResolvedFeature)' != ''">$(DefineConstants);@(_PolyfillResolvedFeature->Distinct(), ';')</DefineConstants>
      <MemoryVersion>@(_PolyfillResolvedFeatureVersion->WithMetadataValue('Identity', 'FeatureMemory')->Metadata('Version')->Distinct())</MemoryVersion>

      <DefineConstants Condition="$(LowerFramework.StartsWith('net11'))">$(DefineConstants);FeatureMemory;FeatureValueTuple;FeatureValueTask;FeatureRuntimeInformation;FeatureHttp;FeatureCompression;FeatureNumerics;FeatureAsyncInterfaces;FeatureUnsafe</DefineConstants>
      <DefineConstants Condition="$(LowerFramework.StartsWith('net10'))">$(DefineConstants);FeatureMemory;FeatureValueTuple;FeatureValueTask;FeatureRuntimeInformation;FeatureHttp;FeatureCompression;FeatureNumerics;FeatureAsyncInterfaces;FeatureUnsafe</DefineConstants>
      <DefineConstants Condition="$(LowerFramework.StartsWith('net9'))">$(DefineConstants);FeatureMemory;FeatureValueTuple;FeatureValueTask;FeatureRuntimeInformation;FeatureHttp;FeatureCompression;FeatureNumerics;FeatureAsyncInterfaces;FeatureUnsafe</DefineConstants>
      <DefineConstants Condition="$(LowerFramework.StartsWith('net8'))">$(DefineConstants);FeatureMemory;FeatureValueTuple;FeatureValueTask;FeatureRuntimeInformation;FeatureHttp;FeatureCompression;FeatureNumerics;FeatureAsyncInterfaces;FeatureUnsafe</DefineConstants>
      <DefineConstants Condition="$(LowerFramework.StartsWith('net7'))">$(DefineConstants);FeatureMemory;FeatureValueTuple;FeatureValueTask;FeatureRuntimeInformation;FeatureHttp;FeatureCompression;FeatureNumerics;FeatureAsyncInterfaces;FeatureUnsafe</DefineConstants>
      <DefineConstants Condition="$(LowerFramework.StartsWith('net6'))">$(DefineConstants);FeatureMemory;FeatureValueTuple;FeatureValueTask;FeatureRuntimeInformation;FeatureHttp;FeatureCompression;FeatureNumerics;FeatureAsyncInterfaces;FeatureUnsafe</DefineConstants>
      <DefineConstants Condition="$(LowerFramework.StartsWith('net5'))">$(DefineConstants);FeatureMemory;FeatureValueTuple;FeatureValueTask;FeatureRuntimeInformation;FeatureHttp;FeatureCompression;FeatureNumerics;FeatureAsyncInterfaces;FeatureUnsafe</DefineConstants>
      <DefineConstants Condition="'$(LowerFramework)'=='netcoreapp3.1'">$(DefineConstants);FeatureMemory;FeatureValueTuple;FeatureValueTask;FeatureRuntimeInformation;FeatureHttp;FeatureCompression;FeatureNumerics;FeatureAsyncInterfaces;FeatureUnsafe</DefineConstants>
      <DefineConstants Condition="'$(LowerFramework)'=='netcoreapp3.0'">$(DefineConstants);FeatureMemory;FeatureValueTuple;FeatureValueTask;FeatureRuntimeInformation;FeatureHttp;FeatureCompression;FeatureNumerics;FeatureAsyncInterfaces;FeatureUnsafe</DefineConstants>
      <DefineConstants Condition="'$(LowerFramework)'=='netcoreapp2.2'">$(DefineConstants);FeatureMemory;FeatureValueTuple;FeatureValueTask;FeatureRuntimeInformation;FeatureHttp;FeatureCompression;FeatureNumerics</DefineConstants>
      <DefineConstants Condition="'$(LowerFramework)'=='netcoreapp2.1'">$(DefineConstants);FeatureMemory;FeatureValueTuple;FeatureValueTask;FeatureRuntimeInformation;FeatureHttp;FeatureCompression;FeatureNumerics</DefineConstants>
      <DefineConstants Condition="'$(LowerFramework)'=='netcoreapp2.0'">$(DefineConstants);FeatureValueTuple;FeatureRuntimeInformation;FeatureHttp;FeatureCompression;FeatureNumerics</DefineConstants>
      <DefineConstants Condition="'$(LowerFramework)'=='net47'">$(DefineConstants);FeatureValueTuple</DefineConstants>
      <DefineConstants Condition="'$(LowerFramework)'=='net471'">$(DefineConstants);FeatureValueTuple;FeatureRuntimeInformation</DefineConstants>
      <DefineConstants Condition="'$(LowerFramework)'=='net472'">$(DefineConstants);FeatureValueTuple;FeatureRuntimeInformation</DefineConstants>
      <DefineConstants Condition="$(LowerFramework.StartsWith('net48'))">$(DefineConstants);FeatureValueTuple;FeatureRuntimeInformation</DefineConstants>
      <DefineConstants Condition="$(LowerFramework.StartsWith('netstandard2.1'))">$(DefineConstants);FeatureMemory;FeatureValueTuple;FeatureValueTask;FeatureRuntimeInformation;FeatureCompression;FeatureNumerics;FeatureAsyncInterfaces</DefineConstants>
      <DefineConstants Condition="$(LowerFramework.StartsWith('netstandard2.0'))">$(DefineConstants);FeatureValueTuple;FeatureRuntimeInformation;FeatureCompression;FeatureNumerics</DefineConstants>
    </PropertyGroup>

    <Warning
      Code="PolyfillMemoryVersion"
      Text="Polyfill: System.Memory version $(MemoryVersion) is installed, but 4.5.5 or newer is required to enable FeatureMemory."
      Condition="'$(PolyfillNoWarnIncorrectVersion)' != 'true' AND '$(MemoryVersion)' != '' AND !$([MSBuild]::VersionGreaterThanOrEquals($(MemoryVersion), '4.5.5'))" />

    <!-- The whole point of EmbeddedAttribute is to avoid the exposing the internal polyfilled APIs to consuming projects via IVT. -->
    <Error Text="PolyPublic and PolyUseEmbeddedAttribute shouldn't be used together." Condition="'$(PolyPublic)' == 'true' AND '$(PolyUseEmbeddedAttribute)' == 'true'" />

    <Error Text="PolyGuard has been renamed to PolyEnsure. Replace &lt;PolyGuard&gt;true&lt;/PolyGuard&gt; with &lt;PolyEnsure&gt;true&lt;/PolyEnsure&gt;." Condition="'$(PolyGuard)' == 'true' AND '$(PolyEnsure)' != 'true'" />
  </Target>
  <ItemGroup>

    <Compile Condition="'$(PolyEnsure)' != 'true' "
             Remove="$(MSBuildThisFileDirectory)..\**\Ensure\*.cs" />

    <Compile Condition="'$(PolyGuard)' != 'true' "
             Remove="$(MSBuildThisFileDirectory)..\**\Guard\*.cs" />

    <Compile Condition="'$(PolyArgumentExceptions)' != 'true' "
             Remove="$(MSBuildThisFileDirectory)..\**\ArgumentExceptions\*.cs" />

    <Compile Condition="'$(PolyNullability)' != 'true' "
             Remove="$(MSBuildThisFileDirectory)..\**\Nullability\*.cs" />

    <Compile Condition="'$(PolyStringInterpolation)' != 'true' "
             Remove="$(MSBuildThisFileDirectory)..\**\StringInterpolation\*.cs" />

    <Compile Update="@(Compile)">
      <Visible Condition="%(NuGetItemType) == 'Compile' and
                          %(NuGetPackageId) == 'Polyfill'">false</Visible>
    </Compile>
  </ItemGroup>
</Project>
